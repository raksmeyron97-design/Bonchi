# =============================================================================
# Bonchi environment template
# =============================================================================
# Copy to .env.local and fill in. Never commit a filled-in copy.
#
#   cp .env.example .env.local
#
# Two credentials, with very different risk profiles:
#
#   ANON KEY          Safe in a client bundle by design. It grants nothing on its
#                     own — every table is protected by row-level security, so an
#                     anonymous caller can read nothing.
#
#   SERVICE ROLE KEY  BYPASSES ROW-LEVEL SECURITY COMPLETELY. It can read every
#                     merchant's customers and ledger. It belongs only in the
#                     admin app's server runtime, and only in
#                     apps/admin/src/lib/supabase/server.ts. It must never appear
#                     in the mobile app, in a Next.js client component, or in CI
#                     logs. scripts/check-secrets.sh enforces this.
# =============================================================================

# --- Mobile app (Expo) -------------------------------------------------------
# EXPO_PUBLIC_* variables are inlined into the JavaScript bundle and are readable
# by anyone who unpacks the APK. Only put public values here.

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# local | development | staging | production
EXPO_PUBLIC_APP_ENV=local
# Optional. Error reporting is disabled when unset.
EXPO_PUBLIC_SENTRY_DSN=

# --- Admin dashboard (Next.js) ----------------------------------------------
# NEXT_PUBLIC_* variables reach the browser. Everything else stays server-side.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_APP_ENV=local

# SERVER ONLY. Bypasses RLS. See the warning above.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional comma-separated allowlist for staff sign-in. Authorization still comes
# from a row in public.platform_admins; this is a belt-and-braces filter.
PLATFORM_ADMIN_EMAILS=

# --- Local development -------------------------------------------------------
# Port used by scripts/db-test.sh for its throwaway PostgreSQL container.
BONCHI_TEST_DB_PORT=55432

# Set by `eas init`. Required only for building with EAS.
EAS_PROJECT_ID=
