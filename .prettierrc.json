{
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 100,
  "tabWidth": 2,
  "arrowParens": "always",
  "endOfLine": "lf",
  "overrides": [
    {
      "files": ["*.md", "*.sql"],
      "options": { "printWidth": 100 }
    },
    {
      "files": ["packages/localization/src/messages/*.json"],
      "options": { "printWidth": 200 }
    }
  ]
}
