{
  "name": "bonchi",
  "private": true,
  "version": "0.1.0",
  "description": "Bonchi (បញ្ជី) — Khmer-first offline debt ledger for small Cambodian businesses",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "admin": "pnpm --filter @bonchi/admin dev",
    "build": "turbo run build",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:env": "./scripts/local-env.sh",
    "db:reset": "supabase db reset",
    "db:seed:check": "./scripts/db-test.sh",
    "db:start": "supabase start",
    "db:status": "supabase status",
    "db:stop": "supabase stop",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local --schema public > packages/database/src/generated/database.types.ts",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,sql}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,sql}\"",
    "lint": "turbo run lint",
    "mobile": "pnpm --filter @bonchi/mobile start",
    "mobile:android": "./scripts/dev-android.sh",
    "sync:check": "node scripts/sync-integration-check.mjs",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "typecheck": "turbo run typecheck",
    "web:preview": "node scripts/web-preview.js"
  },
  "devDependencies": {
    "@bonchi/eslint-config": "workspace:*",
    "@bonchi/typescript-config": "workspace:*",
    "prettier": "^3.9.6",
    "supabase": "^2.109.1",
    "turbo": "^2.10.7",
    "typescript": "5.9.3"
  }
}
